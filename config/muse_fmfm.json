{
    "exp_name": "muse_fmfm",
    "job_type": "train",
    "train_data_path": "./taobao-mm/train",
    "test_data_path": "./taobao-mm/test",
    "feature_map_path": "./taobao-mm/feature_map",
    "ckpt_path": "./ckpt",
    "seed": 42,
    "batch_size": 1000,
    "epochs": 1,
    "dense_lr": 2e-4,
    "sparse_lr": 2e-3,
    "embedding_dim": 16,
    "method": "din",
    "keep_top": 50,
    "use_ddp": true,
    "shuffle": false,
    "shuffle_buffer_size": 1000,
    "use_aux_loss": false,
    "item_id_p90": true,
    "scl_emb_p90": true,
    "feature_map_on_cuda": true,
    "scl_emb_on_cuda": true,
    "save_ckpt": false,
    "width_method": "fmfm",
    "waid_num_fields": 32,
    "waid_fm_embed_dim": 8,
    "waid_fmfm_pair_weights": true
}
